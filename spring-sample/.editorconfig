# ktlint 1.8.0(Spotless)이 읽는 규칙. 바꿀 때는 팀이 합의하고 ./gradlew spotlessApply 로 한 번에 맞춘다.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
ktlint_code_style = ktlint_official
max_line_length = 140
