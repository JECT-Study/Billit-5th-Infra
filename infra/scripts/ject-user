#!/usr/bin/env bash
# 팀원 계정 관리(root). 본인이 보낸 공개키(.pub)만 받는다.
#   ject-user add <username> <공개키 파일> ["이름"]   계정 생성 또는 키 교체. ject-admins(sudo)에 넣는다
#   ject-user lock <username>                        로그인 막기. 홈은 남겨둔다
#   ject-user list
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "root로 실행" >&2; exit 1; }
cmd="${1:-}"; user="${2:-}"
valid_user() { [[ "$1" =~ ^[a-z][a-z0-9-]{1,30}$ ]] && [ "$1" != deploy ] && [ "$1" != root ]; }

case "$cmd" in
add)
  keyfile="${3:?공개키 파일}"; gecos="${4:-JECT developer}"
  valid_user "$user" || { echo "잘못된 사용자 이름: $user" >&2; exit 1; }
  # 공개키 형식 검사 (개인키가 들어오면 거부)
  grep -q "PRIVATE KEY" "$keyfile" && { echo "개인키는 받지 않는다" >&2; exit 1; }
  [ "$(grep -cv '^\s*$' "$keyfile")" -eq 1 ] || { echo "공개키 한 줄만 허용" >&2; exit 1; }
  ssh-keygen -l -f "$keyfile" >/dev/null || { echo "공개키 형식 오류" >&2; exit 1; }
  if ! id "$user" >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash --comment "$gecos" --groups ject-admins "$user"
    passwd -l "$user" >/dev/null
  else
    usermod -aG ject-admins "$user"; usermod -U "$user" 2>/dev/null || true; passwd -l "$user" >/dev/null
  fi
  install -d -m 0700 -o "$user" -g "$user" "/home/$user/.ssh"
  install -m 0600 -o "$user" -g "$user" "$keyfile" "/home/$user/.ssh/authorized_keys"
  echo "ok: $user $(ssh-keygen -l -f "$keyfile" | awk '{print $2}')" ;;
lock)
  valid_user "$user" || exit 1
  usermod -L -e 1 "$user"; gpasswd -d "$user" ject-admins >/dev/null 2>&1 || true
  : > "/home/$user/.ssh/authorized_keys"
  echo "locked: $user" ;;
list)
  getent group ject-admins | cut -d: -f4 | tr , '\n' | while read -r u; do
    [ -n "$u" ] || continue
    fp=$(ssh-keygen -l -f "/home/$u/.ssh/authorized_keys" 2>/dev/null | awk '{print $2}' | head -1)
    echo "$u ${fp:-no-key}"
  done ;;
*) echo "usage: ject-user add|lock|list" >&2; exit 2 ;;
esac
