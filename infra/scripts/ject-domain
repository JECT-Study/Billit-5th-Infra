#!/usr/bin/env bash
# 서비스 주소(도메인) 확인·전환. 운영 앱 VM과 개발 VM에서 각각 sudo로 실행한다.
#   ject-domain show
#   ject-domain check  <운영 이름> [개발 이름]   운영 앱 VM만. Let's Encrypt 스테이징으로 새 이름 발급을 시험한다(바꾸는 것 없음)
#   ject-domain switch <운영 이름> [개발 이름]   새 이름을 대표로 두고 옛 이름은 뒤에 남긴다(옛 주소로 빌드한 앱·보낸 링크도 계속 동작)
# 개발 이름을 빼면 dev.<운영 이름>을 쓴다.
# 순서: DNS A 레코드 2개 → 운영 앱 VM check → 운영 앱 VM switch → 개발 VM switch.
# 바꾸기 전 파일은 /var/backups/ject-domain-<시각>/에 남긴다. 옛 이름을 뺄 때는 edge.env에서 지우고 ject-cert issue.
set -euo pipefail

EDGE_ENV=/srv/ject/app/edge.env
OBS_ENV=/etc/ject/obs.env
AUTH_URL_KEYS='POLICY_CONTENT_BASE_URL|TRIP_INVITATION_BASE_URL'

die() { echo "ject-domain: $*" >&2; exit 1; }

valid_name() { [[ "$1" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]]; }

# 이름 목록 맨 앞에 새 이름을 두고, 뒤에 같은 이름이 있으면 뺀다.
prepend_name() {   # 새 이름, 기존 목록(공백 구분)
  local out="$1" n
  for n in $2; do [ "$n" = "$1" ] || out="$out $n"; done
  echo "$out"
}

# sed 결과를 같은 파일에 다시 써서 권한·소유자를 그대로 둔다(비밀값 파일 0600).
edit() {   # 파일, sed 식
  local tmp; tmp="$(mktemp)"
  sed -E "$2" "$1" > "$tmp" && cat "$tmp" > "$1"
  rm -f "$tmp"
}

set_var() {   # 파일, 키, 값(검사한 이름만 들어온다)
  if grep -q "^$2=" "$1"; then edit "$1" "s#^$2=.*#$2=$3#"; else echo "$2=$3" >> "$1"; fi
}

# 주소의 호스트만 바꾸고 경로는 둔다. 값이 비어 있는 키는 건드리지 않는다.
set_url_host() {   # 파일, 키(정규식), 호스트
  edit "$1" "s#^($2)=https?://[^/\"]*#\1=https://$3#"
}

backup() {
  BACKUP_DIR="/var/backups/ject-domain-$(date +%Y%m%d%H%M%S)"
  install -d -m 0700 "$BACKUP_DIR"
  cp -p "$@" "$BACKUP_DIR"/
  echo "백업: $BACKUP_DIR"
}

redeploy_be() {   # 환경(prod|dev), 상태 폴더 — env 파일을 다시 읽도록 같은 이미지로 재배포
  local img prefix
  img="$(sed -n 's/^JECT_BE_IMAGE=//p' "$2/release.env" | tail -n 1)"
  prefix="$(sed -n 's/^ALLOWED_IMAGE_PREFIX=//p' /etc/ject/deploy.conf | tail -n 1)"
  case "$img" in
    "") echo "$1 BE 배포 기록 없음: 재배포 건너뜀" ;;
    "$prefix"*) /opt/ject/bin/ject-deploy deploy "$1" be "$img" domain-switch ;;
    *) echo "$1 BE는 팀 이미지가 아님($img): 재배포 건너뜀, 첫 배포 때 새 주소를 읽는다" ;;
  esac
}

recreate_alloy() {   # 처음 띄울 때와 같은 compose·env 파일로 다시 만든다(Redis 수집 등 덧붙인 설정 유지)
  local files envs args=() x
  files="$(docker inspect ject-agent-alloy-1 --format '{{index .Config.Labels "com.docker.compose.project.config_files"}}')"
  envs="$(docker inspect ject-agent-alloy-1 --format '{{index .Config.Labels "com.docker.compose.project.environment_file"}}')"
  for x in ${files//,/ }; do args+=(-f "$x"); done
  for x in ${envs//,/ }; do args+=(--env-file "$x"); done
  docker compose -p ject-agent "${args[@]}" up -d alloy
}

http_code() { curl -s -o /dev/null -m 10 -w '%{http_code}' "$@" || true; }

container_urls() {   # 컨테이너 이름
  docker inspect "$1" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | grep -E "^($AUTH_URL_KEYS|PROBE_[A-Z_]*URL)=" | sed "s/^/  $1 /" || true
}

show() {
  case "$ROLE" in
  prod-app)
    grep -E '^(PROD|DEV)_DOMAIN=' "$EDGE_ENV"
    openssl x509 -in "/srv/ject/certs/live/ject/fullchain.pem" -noout -ext subjectAltName -enddate | sed 's/^ */  /'
    grep -E "^($AUTH_URL_KEYS)=" /srv/ject/secrets/prod-be-auth.env || true
    container_urls ject-prod-be-1 ;;
  dev)
    grep -E "^($AUTH_URL_KEYS)=" /srv/ject/secrets/dev-be-auth.env || true
    grep -E '^PROBE_[A-Z_]*URL=' "$OBS_ENV" || true
    container_urls ject-dev-be-1
    container_urls ject-agent-alloy-1 ;;
  *) die "운영 앱 VM 또는 개발 VM에서 실행한다" ;;
  esac
}

check() {   # 운영 이름, 개발 이름
  [ "$ROLE" = prod-app ] || die "check는 운영 앱 VM에서 실행한다"
  local n
  for n in "$1" "$2"; do echo "$n -> $(getent ahostsv4 "$n" | awk '{print $1}' | sort -u | tr '\n' ' ')"; done
  docker compose -p ject-edge -f /opt/ject/compose/prod-edge.yaml run --rm -T certbot certonly --dry-run \
    --webroot -w /var/www/acme -d "$1" -d "$2" --register-unsafely-without-email --agree-tos --non-interactive
}

switch_prod_app() {   # 운영 이름, 개발 이름
  local auth=/srv/ject/secrets/prod-be-auth.env n rc=0
  backup "$EDGE_ENV" "$auth"
  # shellcheck disable=SC1090
  . "$EDGE_ENV"
  set_var "$EDGE_ENV" PROD_DOMAIN "\"$(prepend_name "$1" "${PROD_DOMAIN:-}")\""
  set_var "$EDGE_ENV" DEV_DOMAIN "\"$(prepend_name "$2" "${DEV_DOMAIN:-}")\""
  if ! /opt/ject/bin/ject-cert issue; then
    cp -p "$BACKUP_DIR/edge.env" "$EDGE_ENV"
    die "인증서 발급 실패: edge.env를 되돌렸다(Nginx 설정은 그대로)"
  fi
  set_url_host "$auth" "$AUTH_URL_KEYS" "$1"
  redeploy_be prod /srv/ject/app || rc=1
  # shellcheck disable=SC1090
  . "$EDGE_ENV"
  for n in $PROD_DOMAIN $DEV_DOMAIN; do
    echo "https://$n/readyz $(http_code --resolve "$n:443:127.0.0.1" "https://$n/readyz")"
  done
  return $rc
}

switch_dev() {   # 운영 이름, 개발 이름
  local auth=/srv/ject/secrets/dev-be-auth.env url rc=0
  backup "$auth" "$OBS_ENV"
  set_url_host "$auth" "$AUTH_URL_KEYS" "$2"
  set_url_host "$OBS_ENV" PROBE_PROD_URL "$1"
  set_url_host "$OBS_ENV" 'PROBE_DEV_URL|PROBE_DEV_FE_URL' "$2"
  redeploy_be dev /srv/ject/dev || rc=1
  recreate_alloy || rc=1
  sed -n -E 's/^PROBE_[A-Z_]*URL=(https?:.*)/\1/p' "$OBS_ENV" | while read -r url; do
    echo "$url $(http_code "$url")"
  done
  return $rc
}

ROLE="$(cat /etc/ject/role 2>/dev/null || true)"
CMD="${1:-}"
[ "$(id -u)" -eq 0 ] || die "sudo로 실행한다"
case "$CMD" in
show) show ;;
check|switch)
  P="${2:-}"; D="${3:-dev.${2:-}}"
  if ! valid_name "$P" || ! valid_name "$D"; then die "이름 형식 오류: '$P' '$D' (소문자 도메인 이름)"; fi
  if [ "$CMD" = check ]; then check "$P" "$D"
  elif [ "$ROLE" = prod-app ]; then switch_prod_app "$P" "$D"
  elif [ "$ROLE" = dev ]; then switch_dev "$P" "$D"
  else die "운영 앱 VM 또는 개발 VM에서 실행한다"; fi ;;
*) die "사용법: ject-domain show | check <운영 이름> [개발 이름] | switch <운영 이름> [개발 이름]" ;;
esac
