[Unit]
Description=JECT 백업 복원 시험 (격리 임시 컨테이너)
After=docker.service network-online.target
Requires=docker.service

[Service]
# 성공·실패와 관계없이 결과를 지표 파일로 남긴다(Grafana 「백업 실패」 알림).
ExecStopPost=/opt/ject/bin/ject-backup-metrics
Type=oneshot
ExecStart=/opt/ject/bin/ject-pg-restore-test latest
Nice=10
TimeoutStartSec=2h
