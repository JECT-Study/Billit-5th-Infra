// 개발 VM 전용 opt-in. 받는 service는 합성 시험용 infra-validation과 개발 BE(billit-be)뿐이다.
// 그 밖의 service와 links 있는 span은 폐기. 원문 로그/debug exporter 없음.
// billit-be는 span 이름(라우트 패턴·저장소 메서드·SQL 동작)과 http.route, DB 동작·테이블 이름까지 남긴다.
// URL·쿼리·본문·SQL 문·식별자·예외 메시지·이벤트는 어느 service든 남기지 않는다.
// HTTP endpoint는 컨테이너 내부; Compose는 호스트 루프백만 공개한다.
logging { level = "warn" }

otelcol.receiver.otlp "dev" {
  http {
    endpoint = "0.0.0.0:4318"
    max_request_body_size = "1MiB"
    compression_algorithms = [""]
    read_header_timeout = "3s"
    read_timeout = "5s"
    write_timeout = "5s"
  }
  output {
    traces = [otelcol.processor.memory_limiter.dev.input]
  }
}

// heap 제한과 컨테이너 RSS 상한을 별도로 둔다.
otelcol.processor.memory_limiter "dev" {
  check_interval = "1s"
  limit = "128MiB"
  spike_limit = "32MiB"
  output {
    traces = [otelcol.processor.filter.reject_links.input]
  }
}

otelcol.processor.filter "reject_links" {
  error_mode = "propagate"
  traces {
    span = [`Len(links) > 0`, `resource.attributes["service.name"] != "infra-validation" and resource.attributes["service.name"] != "billit-be"`]
    spanevent = [`true`]
  }
  output {
    traces = [otelcol.processor.tail_sampling.drop_health.input]
  }
}

// 상태 확인(/healthz, /readyz)과 지표 수집(/actuator/prometheus) 요청은 몇 초마다 들어와 실제 API 추적을 가린다.
// 그런 요청이 낀 trace를 통째로 버린다(자식 span만 남지 않게 trace 단위로 판단, 5초 모아서 결정).
otelcol.processor.tail_sampling "drop_health" {
  decision_wait = "5s"
  num_traces = 2000
  expected_new_traces_per_sec = 10
  policy {
    name = "drop-health-checks"
    type = "string_attribute"
    string_attribute {
      key = "http.route"
      values = ["/healthz", "/readyz", "/actuator/prometheus"]
      invert_match = true
    }
  }
  output {
    traces = [otelcol.processor.transform.sanitize.input]
  }
}

otelcol.processor.transform "sanitize" {
  error_mode = "propagate"
  trace_statements {
    context = "resource"
    statements = [
      `keep_keys(attributes, ["service.name"])`,
      `set(attributes["deployment.environment.name"], "dev")`,
      `set(schema_url, "")`,
    ]
  }
  trace_statements {
    context = "scope"
    statements = [
      `keep_keys(attributes, [])`,
      `set(name, "sanitized")`,
      `set(version, "")`,
      `set(schema_url, "")`,
    ]
  }
  trace_statements {
    context = "span"
    statements = [
      `set(name, "operation") where resource.attributes["service.name"] != "billit-be" or not IsMatch(name, "^[A-Za-z0-9 ._/{}*:$-]{1,120}$")`,
      `set(trace_state, "")`,
      `set(status.message, "")`,
      `keep_keys(attributes, ["http.request.method", "http.response.status_code", "db.system", "http.route", "db.system.name", "db.operation.name", "db.collection.name"])`,
      `delete_key(attributes, "http.route") where resource.attributes["service.name"] != "billit-be" or not IsMatch(attributes["http.route"], "^/[A-Za-z0-9._/{}*-]{0,119}$")`,
      `delete_key(attributes, "db.system.name") where resource.attributes["service.name"] != "billit-be" or (attributes["db.system.name"] != "postgresql" and attributes["db.system.name"] != "redis")`,
      `delete_key(attributes, "db.operation.name") where resource.attributes["service.name"] != "billit-be" or not IsMatch(attributes["db.operation.name"], "^[A-Za-z ]{1,32}$")`,
      `delete_key(attributes, "db.collection.name") where resource.attributes["service.name"] != "billit-be" or not IsMatch(attributes["db.collection.name"], "^[A-Za-z0-9_.]{1,64}$")`,
      `delete_key(attributes, "http.request.method") where attributes["http.request.method"] != "GET" and attributes["http.request.method"] != "POST" and attributes["http.request.method"] != "PUT" and attributes["http.request.method"] != "PATCH" and attributes["http.request.method"] != "DELETE" and attributes["http.request.method"] != "HEAD" and attributes["http.request.method"] != "OPTIONS"`,
      `delete_key(attributes, "db.system") where attributes["db.system"] != "postgresql" and attributes["db.system"] != "redis"`,
      `delete_key(attributes, "http.response.status_code") where not IsInt(attributes["http.response.status_code"])`,
      `delete_key(attributes, "http.response.status_code") where attributes["http.response.status_code"] != nil and (attributes["http.response.status_code"] < 100 or attributes["http.response.status_code"] > 599)`,
    ]
  }
  output {
    traces = [otelcol.processor.batch.dev.input]
  }
}

// max_size는 span 개수 상한이며 요청 바이트·전체 저장량 상한이 아니다.
otelcol.processor.batch "dev" {
  send_batch_size = 16
  send_batch_max_size = 32
  timeout = "200ms"
  output {
    traces = [otelcol.exporter.otlphttp.dev.input]
  }
}

otelcol.exporter.otlphttp "dev" {
  encoding = "json"
  client {
    endpoint = "http://tempo:4318"
    timeout = "5s"
    compression = "none"
  }
  sending_queue {
    enabled = true
    num_consumers = 1
    queue_size = 2097152
    sizer = "bytes"
    block_on_overflow = false
  }
  retry_on_failure {
    enabled = true
    initial_interval = "1s"
    max_interval = "5s"
    max_elapsed_time = "30s"
  }
}
