  {
   "type": "timeseries",
   "title": "요청 수(상태별)",
   "id": 7,
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by(host) (count_over_time({service=\"nginx\", host=~\"$host\"} | json status=\"status\", ua=\"ua\" | __error__=\"\" | ua !~ \"Blackbox Exporter.*\" | status < 400 [$__auto]))",
     "legendFormat": "{{host}} 정상(2xx·3xx)"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by(host) (count_over_time({service=\"nginx\", host=~\"$host\"} | json status=\"status\", ua=\"ua\" | __error__=\"\" | ua !~ \"Blackbox Exporter.*\" | status >= 400, status < 500 [$__auto]))",
     "legendFormat": "{{host}} 4xx"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by(host) (count_over_time({service=\"nginx\", host=~\"$host\"} | json status=\"status\", ua=\"ua\" | __error__=\"\" | ua !~ \"Blackbox Exporter.*\" | status >= 500 [$__auto]))",
     "legendFormat": "{{host}} 5xx"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 70,
      "showPoints": "never",
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "axisSoftMin": 0
     },
     "unit": "short"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*5xx"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*4xx"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "운영 앱 서버의 Nginx는 공개 입구라 개발 주소로 들어온 요청도 한 번 지나갑니다(개발 서버 게이트웨이에서 한 번 더 기록). 4xx에는 알 수 없는 주소로 들어온 자동 스캔을 끊은 444가 포함됩니다."
  },
  {
   "type": "timeseries",
   "title": "응답 시간 p95(상태 확인 경로 제외)",
   "id": 8,
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "quantile_over_time(0.95, {service=\"nginx\", host=~\"$host\"} | json rt=\"request_time\", path=\"path\", ua=\"ua\" | __error__=\"\" | ua !~ \"Blackbox Exporter.*\" | path !~ \"/readyz|/healthz|/nginx-health\" | rt != \"\" | unwrap rt [$__auto]) by (host)",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "points",
