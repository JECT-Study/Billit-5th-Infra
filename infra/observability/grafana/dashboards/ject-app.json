   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by(host) (rate(http_server_requests_seconds_count{host=~\"$host\"}[5m]))",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "5xx 비율",
   "id": 7,
   "gridPos": {
    "x": 8,
    "y": 7,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by(host) (rate(http_server_requests_seconds_count{host=~\"$host\", status=~\"5..\"}[5m])) / sum by(host) (rate(http_server_requests_seconds_count{host=~\"$host\"}[5m]))",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "응답 p95",
   "id": 8,
   "gridPos": {
    "x": 16,
    "y": 7,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.95, sum by(le, host) (rate(http_server_requests_seconds_bucket{host=~\"$host\", uri!~\"/actuator.*|/readyz|/healthz\"}[5m])))",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "table",
   "title": "경로별 요청·평균 응답(5분)",
   "id": 9,
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by(host, method, uri, status) (rate(http_server_requests_seconds_count{host=~\"$host\"}[5m]))",
     "format": "table",
     "instant": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by(host, method, uri, status) (rate(http_server_requests_seconds_sum{host=~\"$host\"}[5m])) / sum by(host, method, uri, status) (rate(http_server_requests_seconds_count{host=~\"$host\"}[5m]))",
     "format": "table",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
