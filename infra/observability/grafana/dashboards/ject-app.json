{
 "uid": "ject-app",
 "title": "JECT 앱",
 "tags": [
  "ject"
 ],
 "timezone": "Asia/Seoul",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "host",
    "label": "서버",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "query": "label_values(up{job=\"app\"}, host)",
    "definition": "label_values(up{job=\"app\"}, host)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "상태",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "앱 지표 수집",
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "last_over_time(up{job=\"app\", host=~\"$host\"}[2m])",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "끊김",
         "color": "red"
        },
        "1": {
         "text": "정상",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "type": "stat",
   "title": "앱 가동 시간",
   "id": 3,
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "time() - process_start_time_seconds{job=\"app\", host=~\"$host\"}",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "type": "timeseries",
   "title": "스모크 앱 요청(실제 앱이 오면 비어 있음)",
   "id": 4,
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 12,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by(host, pattern, status) (rate(ject_smoke_http_requests_total{host=~\"$host\"}[5m]))",
     "legendFormat": "{{host}} {{pattern}} {{status}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "row",
   "title": "HTTP (Spring Boot Micrometer)",
   "id": 5,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "요청 수",
   "id": 6,
   "gridPos": {
