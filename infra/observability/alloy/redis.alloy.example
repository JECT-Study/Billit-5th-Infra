// 선택 적용 초안. 기본 설치 대상이 아니며 ACL/실제 수집 검증 후에만 활성화한다.
// 주소에 인증정보를 넣지 않는다. 비밀번호는 별도 읽기 전용 secret 파일로 전달한다.
prometheus.exporter.redis "ject" {
  redis_addr          = sys.env("JECT_REDIS_METRICS_ADDR")
  redis_user          = sys.env("JECT_REDIS_METRICS_USER")
  redis_password_file = "/run/secrets/redis_metrics_password"
  connection_timeout  = "5s"
  export_key_values   = false
  export_client_list  = false
  set_client_name     = false
  // CONFIG GET *는 requirepass를 포함할 수 있다. 고정 exporter의 '-' 비활성화를 사용한다.
  config_command      = "-"
}

prometheus.scrape "redis" {
  targets         = prometheus.exporter.redis.ject.targets
  job_name        = "integrations/redis"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.relabel.host.receiver]
}
